module ConvertSdk
  # The outbound delivery manager — owns the VisitorsQueue, the tracking
  # endpoint, queue release, and the wire-payload builder (boundary #2).
  # @api private.
  class ApiManager
    SOURCE: String
    ENRICH_DATA: bool
    CONFIG_BY_EXPERIENCE_TTL: Integer

    self.@config_by_experience_cache: Hash[String, Hash[String, untyped]]
    self.@config_by_experience_mutex: Thread::Mutex

    @config: Config
    @data_manager: DataManager
    @http_client: HttpClient
    @event_manager: EventManager
    @log_manager: LogManager
    @queue: VisitorsQueue
    @flush_timer: BackgroundTimer

    attr_reader queue: VisitorsQueue

    def self.cached_config_by_experience: (String cache_key) -> Hash[String, untyped]?

    def self.memoize_config_by_experience: (String cache_key, Hash[String, untyped] config) -> void

    def self.reset_config_by_experience_cache_for_tests!: () -> void

    def self.config_by_experience_cache_size_for_tests: () -> Integer

    def initialize: (
      config: Config,
      data_manager: DataManager,
      http_client: HttpClient,
      event_manager: EventManager,
      log_manager: LogManager
    ) -> void

    def enqueue: (String visitor_id, Hash[String, untyped] event, ?segments: Hash[String, untyped]?) -> void

    def release_queue: (?String? reason) -> void

    def get_config_by_experience: (String experience_id) -> Hash[String, untyped]?

    private

    def guard_fork_boundary: () -> void

    def clear_queue_ownership: () -> void

    def deliver: (Array[Hash[String, untyped]] visitors, String? reason) -> void

    def ensure_flush_timer!: () -> void

    def flush_tick: () -> void

    def count_events: (Array[Hash[String, untyped]] visitors) -> Integer

    def build_payload: (Array[Hash[String, untyped]] visitors) -> Hash[String, untyped]

    def post_payload: (Hash[String, untyped] payload) -> HttpClient::Response

    def track_url: () -> String

    def sdk_key: () -> String

    def auth_headers: () -> Hash[String, String]

    def fetch_config_by_experience: (String cache_key, String experience_id) -> Hash[String, untyped]?

    def config_by_experience_url: (String experience_id) -> String
  end
end
